#include <windows.h>
#include "ids.h"

// 应用图标
100 ICON "app.ico"

// 应用清单：comctl v6 + PerMonitorV2 DPI（ld 的空清单合并警告无害，最终保留本清单）
1 24 "app.manifest"

// 内嵌 WebView2Loader.dll（x64），运行时释放，保证单文件分发
101 RCDATA "WebView2Loader.dll"

// 版本信息（资源管理器 → 文件属性 → 详细信息）
1 VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "空.城"
            VALUE "FileDescription", "cookie抓取工具3.0 · Cookie / Token 抓取工具"
            VALUE "FileVersion", "3.0.0.0"
            VALUE "InternalName", "cookie抓取工具3.0"
            VALUE "LegalCopyright", "Copyright (c) 空.城"
            VALUE "OriginalFilename", "cookie抓取工具3.0.exe"
            VALUE "ProductName", "cookie抓取工具3.0"
            VALUE "ProductVersion", "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
