{
  "themeName": "Glassmorphism Night",
  "version": "3.0.0",
  "description": "玻璃质感 UI 主题设计令牌，供独立原型与安全的桌面工作台界面复用。",
  "colors": {
    "background": "#071326",
    "backgroundSecondary": "#0B1930",
    "glassSurface": "rgba(255,255,255,0.075)",
    "glassSurfaceStrong": "rgba(20,41,70,0.68)",
    "glassBorder": "rgba(205,229,255,0.15)",
    "glassBorderHighlight": "rgba(223,240,255,0.27)",
    "textPrimary": "#EEF6FF",
    "textSecondary": "#98AFCE",
    "accentBlue": "#4C8DFF",
    "accentCyan": "#6BE6EF",
    "accentViolet": "#A797FF",
    "success": "#51E5B0"
  },
  "effects": {
    "panelBlurPx": 24,
    "panelSaturatePercent": 135,
    "shadow": "0 22px 55px rgba(0,0,0,0.22)",
    "highlight": "inset 0 1px 0 rgba(255,255,255,0.105)"
  },
  "radii": { "small": 12, "card": 16, "window": 18, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 18, "xl": 24, "2xl": 32 }
}
